# Supabase project configuration (use publishable key; legacy anon key remains supported)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy key name supported for existing Supabase projects:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public canonical site origin, e.g. https://dairybuy.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=
